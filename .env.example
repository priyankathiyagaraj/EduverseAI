# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-here

# MySQL Database Configuration
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
MYSQL_USER=your-local-mysql-user
MYSQL_PASSWORD=your-local-mysql-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=eduverse_ai

# Set DATABASE_URL if you want to override explicitly
# Example for MySQL:
# DATABASE_URL=mysql+pymysql://your-local-mysql-user:your-local-mysql-password@localhost:3306/eduverse_ai
# Example for local development / testing fallback:
DATABASE_URL=sqlite:///eduverse_dev.db
